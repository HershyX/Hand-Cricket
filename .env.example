# =============================================================
# Hand Cricket Online - Environment Variables
# =============================================================
# Copy this file to .env and fill in real values.
# NEVER commit real secrets to the repository.
# =============================================================

# --- Backend --------------------------------------------------
# The backend's own bind host/port (used by uvicorn).
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Team size limits. The host configures Team A and Team B independently, each
# within the inclusive range [MIN_TEAM_SIZE, MAX_TEAM_SIZE].
MIN_TEAM_SIZE=1
MAX_TEAM_SIZE=10

# --- Frontend -------------------------------------------------
# Base URL of the backend API that the frontend talks to.
# Used during development for API calls.
VITE_BACKEND_URL=http://localhost:8000

# Base URL of the backend WebSocket endpoint.
# Used during development for real-time sync.
VITE_WS_URL=ws://localhost:8000/ws

# --- Database -------------------------------------------------
# PostgreSQL connection string (not used yet, reserved for later phases).
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/hand_cricket
